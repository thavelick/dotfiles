[
    {
        "name": "system package updates",
        "command": "sudo pacman -Syu --noconfirm && ~/Projects/dotfiles/arch/pkgbuilds/install.sh && npm update -g --min-release-age 7 && uv tool upgrade --all --exclude-newer '1 week'",
        "interval": "7"
    },
    {
        "name": "prune package caches",
        "command": "sudo rm -rf /var/cache/pacman/pkg/download-* && sudo pacman -Sc --noconfirm",
        "interval": "31"
    },
    {
        "name": "prune backups",
        "command": "sudo -E borg prune -v --list --keep-within=89d /backuprepo && sudo -E borg compact --progress /backuprepo",
        "interval": "37"
    },
    {
        "name": "backups",
        "command": "sudo -E borg create --progress --exclude-from=/home/tristan/Projects/dotfiles/arch/backup_excludes.txt \"/backuprepo/::system-$(date +%s)\" /",
        "interval": "11"
    },
    {
        "name": "sync backups to bernard",
        "command": "sudo rclone --config /home/tristan/.config/rclone/rclone.conf sync -P /backuprepo bernard:/media/disk2/backup/\"$(uname -n)\"",
        "interval": "11"
    },
    {
        "name": "sync backups to cloud",
        "command": "sudo rclone --config /home/tristan/.config/rclone/rclone.conf sync --transfers=10 -P /backuprepo system-backup:thavelick-backup/\"$(uname -n)\"",
        "interval": "11"
    },
    {
        "name": "import browser history",
        "command": "~/Projects/browser-history/browser_history.py import",
        "interval": "13"
    }
]
